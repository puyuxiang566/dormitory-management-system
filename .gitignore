# 依赖（node_modules/ 匹配任意深度，同时排除发布包内的依赖）
/node_modules
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# 测试覆盖率
/coverage

# Next.js 构建产物
/.next/
/out/

# 生产构建
/build
/dist

# 环境变量（含数据库密钥，禁止提交）
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 缓存与构建信息
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# IDE / 编辑器
.vscode/*
!.vscode/extensions.json
.idea
*.swp

# AI / 工具缓存目录（非项目源码，体积大）
.arts/
.opnecode/
.codeartsdoer/
.codebuddy/
.omo/
.sisyphus/
.trae/
.workbuddy

# 操作系统
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# 压缩包等大文件
*.rar

# Windows 快捷方式（指向本机服务，机器专用）
*.lnk

# 发布包工作目录（本地存放发布版文件，打包后上传 GitHub Releases，不入库）
/宿舍管理应用/

# Release 打包产物
*.zip

# C# 启动器（Launcher/）构建与测试产物
/Launcher/bin/
/Launcher/obj/
/Launcher/test-output/
